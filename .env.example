# Copy to .env (git-ignored) and fill in.
# docker compose reads .env automatically. Spring Boot does not: export the variables in your shell,
# IDE run configuration or direnv before ./mvnw -pl agent-app spring-boot:run.
# spring-boot:test-run needs none of these (Testcontainers + stub model).
# scripts/demo.sh needs none of these either: it sets POSTGRES_PASSWORD and a demo-only APPROVAL_TOKEN_SECRET.

# --- PostgreSQL (compose.yaml and agent-app default profile) -------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workflow
POSTGRES_USER=workflow
POSTGRES_PASSWORD=workflow

# --- Keycloak admin console (local only) ----------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- JWT resource server (defaults: realm from compose.yaml) --------------------------------------
OAUTH2_ISSUER_URI=http://localhost:8180/realms/workflow
OAUTH2_AUDIENCE=workflow-api

# --- Default profile: OpenAI ----------------------------------------------------------------------
OPENAI_API_KEY=
# Optional: override Spring AI's default chat model.
# SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=
OPENAI_TIMEOUT=30s
OPENAI_MAX_RETRIES=2
OPENAI_MAX_COMPLETION_TOKENS=1000

# --- Profile "azure": Azure OpenAI through the unified OpenAI starter -----------------------------
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# --- Profile "lmstudio": LM_STUDIO=1 ./mvnw -pl agent-app spring-boot:test-run --------------------
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Model id as listed by: curl http://127.0.0.1:1234/v1/models
LMSTUDIO_MODEL=

# --- Approval tokens: HMAC-SHA256 secret, the same for agent-app (M4) and mock-crm-mcp. Generate: openssl rand -base64 32 ----
APPROVAL_TOKEN_SECRET=

# --- Tools (agent-app from M3): mock-crm-mcp and mock-rates, started with ./mvnw -pl <module> spring-boot:run --
CRM_URL=http://localhost:8091
RATES_URL=http://localhost:8092
# Optional: slow or error, sent to mock-rates as X-Simulate to demo timeouts and outages.
RATES_SIMULATE=
# Who gets the mail when an approval task is still open at its SLA (agent-app from M5).
APPROVALS_ESCALATION_TO=approvals-lead@nordline.test
# How long to wait for the customer after a quote, and again after the one reminder (agent-app from M6).
FOLLOW_UP_AFTER=72h

# --- Mail (Mailpit from compose.yaml; used by scripts/send-mail.sh, agent-app from M1) ------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_API_URL=http://localhost:8025
QUOTES_INBOX=quotes@nordline.test

# --- Grafana LGTM (compose.yaml): agent-app sends traces and metrics over OTLP (M7) -------------------
OTLP_ENDPOINT=http://localhost:4318
# Share of traces kept in the default profile (the demo profile keeps all).
TRACING_SAMPLING_PROBABILITY=0.1
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
