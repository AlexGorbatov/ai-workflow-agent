<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.altronixsoft</groupId>
    <artifactId>ai-workflow-agent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>ai-workflow-agent</name>
    <description>AI Business Workflow Agent: email freight requests to approved quotes on a durable state machine</description>
    <url>https://github.com/AlexGorbatov/ai-workflow-agent</url>

    <!-- Our own; without these the Spring Boot parent's Apache 2.0 license, URL and team would be inherited. -->
    <licenses>
        <license>
            <name>PolyForm Noncommercial License 1.0.0</name>
            <url>https://polyformproject.org/licenses/noncommercial/1.0.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Alex Gorbatov</name>
            <url>https://github.com/AlexGorbatov</url>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/AlexGorbatov/ai-workflow-agent</url>
        <connection>scm:git:https://github.com/AlexGorbatov/ai-workflow-agent.git</connection>
    </scm>

    <modules>
        <module>approval-token</module>
        <module>operator-ui</module>
        <!-- The mocks build before agent-app: its integration tests start their executable jars. -->
        <module>mock-crm-mcp</module>
        <module>mock-rates</module>
        <module>agent-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <db-scheduler.version>16.12.0</db-scheduler.version>
        <archunit.version>1.5.1</archunit.version>
        <spotless.version>3.10.3</spotless.version>
        <palantir-java-format.version>2.99.0</palantir-java-format.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Versions managed here; agent-app declares the dependency. -->
            <dependency>
                <groupId>com.github.kagkarlsson</groupId>
                <artifactId>db-scheduler-spring-boot-4-starter</artifactId>
                <version>${db-scheduler.version}</version>
            </dependency>
            <dependency>
                <groupId>com.altronixsoft</groupId>
                <artifactId>approval-token</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.altronixsoft</groupId>
                <artifactId>operator-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- *Test = unit/slice (surefire), *IT = Spring context + Testcontainers (failsafe), @Tag("eval") = -Pevals only. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>eval</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <excludedGroups>eval</excludedGroups>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                            <style>PALANTIR</style>
                        </palantirJavaFormat>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
